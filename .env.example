# 默认无需密钥，启动程序不会读取此文件。通过终端环境变量显式配置。
GUIDE_ALLOW_REMOTE_LLM=false
GUIDE_LLM_API_KEY=
GUIDE_LLM_MODEL=deepseek-chat
# GUIDE_DATA_DIR=绝对路径

# 联网搜索和AI生成是两套独立开关与密钥。程序仍不自动读取此文件。
# 按Brave Search API官方说明申请自己的搜索密钥，可能产生费用。
CAMPUSMATE_ALLOW_SEARCH=false
CAMPUSMATE_SEARCH_PROVIDER=brave
CAMPUSMATE_SEARCH_API_KEY=
