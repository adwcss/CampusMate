# 默认无需密钥，启动程序不会读取此文件。通过终端环境变量显式配置。
GUIDE_ALLOW_REMOTE_LLM=false
GUIDE_LLM_API_KEY=
GUIDE_LLM_MODEL=deepseek-chat
# GUIDE_DATA_DIR=绝对路径

# false 关闭联网检索。启用 DeepSeek 后，自动检索使用上述服务端密钥补查。
# 官网公告索引无需密钥。CAMPUSMATE_SEARCH_API_KEY 仅用于 Brave。
CAMPUSMATE_ALLOW_SEARCH=true
CAMPUSMATE_SEARCH_PROVIDER=official
CAMPUSMATE_SEARCH_API_KEY=
